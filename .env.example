# ==============================================================================
# Tribal Scholar — Local Full Production-Like Deployment Environment Template
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=local-dev-insecure-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL Database Configuration (PostgreSQL is required; SQLite forbidden)
DATABASE_ENGINE=postgresql
POSTGRES_DB=tribal_scholar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Message Broker & Cache
REDIS_URL=redis://redis:6379/0

# Worker Topology & Roles (Fail-closed architecture gate: 'scanner' or 'ocr' only)
# WORKER_ROLE=scanner  # Used in worker-scanner container
# WORKER_ROLE=ocr      # Used in worker-ocr container
MALWARE_SCANNER_BACKEND=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
OCR_ENGINE_BACKEND=paddleocr

# Object Storage Configuration (Local persistent storage or MinIO S3-compatible)
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=tribal-scholar-docs
MINIO_USE_SSL=False

# Provenance & Scheme Validation
ENFORCE_STRICT_SCHEME_VALIDATION=True

# Fast2SMS Gateway Configuration (Optional in local development)
FAST2SMS_API_KEY=
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_ENABLED=false
FAST2SMS_ROUTE=q
