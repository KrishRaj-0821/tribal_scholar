# Django Settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# PostgreSQL Database Configuration (Placeholders Only - Never commit actual values)
# NOTE: Concurrency stress tests (test_concurrency_stress.py) REQUIRE PostgreSQL.
#       They will be automatically skipped when POSTGRES_DB is not set.
#       Default system PostgreSQL port is 5432.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Backward-compatibility aliases
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis & Celery
REDIS_URL=

# Object Storage (MinIO / S3)
STORAGE_BACKEND=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_USE_SSL=

# Security & Provenance Validation
ENFORCE_STRICT_SCHEME_VALIDATION=
