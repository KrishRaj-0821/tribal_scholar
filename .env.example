# Django Settings
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Database Configuration (PostgreSQL is required for test suite & integrity gate)
DATABASE_ENGINE=postgresql
POSTGRES_DB=tribal_scholar
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Backward-compatibility aliases
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Redis & Celery
REDIS_URL=

# Object Storage (MinIO / S3)
STORAGE_BACKEND=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_USE_SSL=

# Security & Provenance Validation
ENFORCE_STRICT_SCHEME_VALIDATION=

# Fast2SMS Gateway Configuration
FAST2SMS_API_KEY=
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_ENABLED=true
FAST2SMS_ROUTE=q

